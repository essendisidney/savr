NEXT_PUBLIC_SUPABASE_URL=https://thmxbhpuomggphgdzllk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Soft-launch support chrome (client)
NEXT_PUBLIC_SUPPORT_EMAIL=support@savr.app
# Optional WhatsApp — E.164 or wa.me path, e.g. 254712345678
# NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Invite gate (middleware cookie). Set INVITE_GATE_ENABLED=false to open the app without a code.
INVITE_GATE_ENABLED=false
INVITE_COOKIE_SECRET=change-me-long-random

# Server-only — required for phone OTP (Taifa) + session minting
SUPABASE_SERVICE_ROLE_KEY=

# Taifa Mobile SMS (same account pattern as CREDA)
TAIFA_API_KEY=
TAIFA_SENDER_ID=SIDNET

# Set true only for local testing without SMS
# SMS_BYPASS=true

# M-Pesa Daraja B2C — dry-run by default (no money moved)
MPESA_DRY_RUN=true
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=https://savr-teal.vercel.app/api/mpesa/b2c/result
MPESA_B2C_TIMEOUT_URL=https://savr-teal.vercel.app/api/mpesa/b2c/timeout
# Optional: Bearer token for POST /api/mpesa/disburse (defaults to service role)
# MPESA_DISBURSE_SECRET=

# Analytics: @vercel/analytics + @vercel/speed-insights mount automatically on Vercel — no key needed
